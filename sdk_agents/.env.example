# Copy this file to .env and fill in your API key
# Never commit .env to git
#
# Choose which provider powers the agents: "groq" or "gemini"
# Groq's free tier only supports schema-enforced JSON on 2 models, capped at
# 8,000 tokens/minute — too small for this project's larger agent prompts.
# Gemini's free tier (no credit card) has much more headroom — recommended.
LLM_PROVIDER=gemini

# Groq — get a FREE key (no credit card) at: console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# Gemini — get a FREE key (no credit card) at: aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
